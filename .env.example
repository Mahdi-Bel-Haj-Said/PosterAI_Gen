# OpenAI — used for prompt generation (GPT-4o) and image generation (gpt-image-2)
OPENAI_API_KEY=sk-...

# Google Gemini — used for social-caption generation on completed posters.
# Free tier of gemini-2.5-flash covers normal usage. Generate a key in
# Google AI Studio (https://aistudio.google.com/app/apikey). Leave blank
# to disable caption endpoints; share features still work without it.
GEMINI_API_KEY=

# RunPod — reserved for future fine-tuned SD background generation (currently unused)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Cloudflare R2 — object storage for assets, posters, and style DNA.
# Bucket is shared with Defendr; this service namespaces everything under R2_KEY_PREFIX.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_KEY_PREFIX=defendr-poster-ai
# Optional: public base URL (r2.dev or custom domain). Leave blank to use presigned URLs.
R2_PUBLIC_URL=

# Publicly reachable base URL of this API. Used to build share landing-page URLs
# (/p/{job_id}) that get embedded in Twitter / OpenGraph meta tags so social
# platforms render proper image previews. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Postiz — self-hosted social posting aggregator (handles OAuth + per-platform
# APIs for Twitter, Facebook, Instagram, LinkedIn, etc.). Generate the API key
# in the Postiz UI: Settings → Public API. Leave blank to disable native-post
# endpoints; the basic Twitter/FB share-intent buttons keep working either way.
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=

# Tenant authentication.
# ADMIN_TOKEN gates the admin-only endpoints (API-key issuance/revocation,
# admin usage). Sent as the `X-Admin-Token` header. Blank = admin endpoints
# refuse all requests.
ADMIN_TOKEN=
# API_KEY_REQUIRED toggles per-platform auth on every org-scoped endpoint. A key
# authenticates a PLATFORM (the integrating customer); the platform addresses
# many orgs by passing org_id per request. When true, callers MUST send
# `Authorization: Bearer <api-key>`, the platform is taken from the key, and
# org_id must name an org registered under it (POST /v1/orgs) — all data is
# namespaced + isolated per platform. When false (dev default), org_id is passed
# directly, platform is null (flat single-tenant layout) and there's no
# enforcement, but any key that IS sent is still validated. Flip to true before
# exposing the API beyond localhost.
API_KEY_REQUIRED=false

# Webhooks — push a signed event to a platform's callback URL when a poster
# finishes. OFF by default: with this false, nothing about the pipeline changes.
# Turn on only when you want to use/test webhooks. A platform registers its URL
# via PUT /v1/webhook; deliveries run on the `epai-webhooks` queue (the existing
# worker already drains it).
WEBHOOKS_ENABLED=false
# WEBHOOK_TIMEOUT_SECONDS=5
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_BACKOFF_BASE_SECONDS=10
# Dev-only: allow http:// and localhost/private callback URLs (e.g. to test
# against a local listener). Keep false in production (HTTPS + SSRF guard).
WEBHOOK_ALLOW_INSECURE_URLS=false

# Optional overrides
# OPENAI_PROMPT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2
# STAGE2_BUDGET_USD=0.10
# LOG_LEVEL=INFO
