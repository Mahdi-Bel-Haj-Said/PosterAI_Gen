# OpenAI — used for prompt generation (GPT-4o) and image generation (gpt-image-2)
OPENAI_API_KEY=sk-...

# Google Gemini — used for social-caption generation on completed posters.
# Free tier of gemini-2.5-flash covers normal usage. Generate a key in
# Google AI Studio (https://aistudio.google.com/app/apikey). Leave blank
# to disable caption endpoints; share features still work without it.
GEMINI_API_KEY=

# RunPod — reserved for future fine-tuned SD background generation (currently unused)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Cloudflare R2 — object storage for assets, posters, and style DNA.
# Bucket is shared with Defendr; this service namespaces everything under R2_KEY_PREFIX.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_KEY_PREFIX=defendr-poster-ai
# Optional: public base URL (r2.dev or custom domain). Leave blank to use presigned URLs.
R2_PUBLIC_URL=

# Publicly reachable base URL of this API. Used to build share landing-page URLs
# (/p/{job_id}) that get embedded in Twitter / OpenGraph meta tags so social
# platforms render proper image previews. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Postiz — self-hosted social posting aggregator (handles OAuth + per-platform
# APIs for Twitter, Facebook, Instagram, LinkedIn, etc.). Generate the API key
# in the Postiz UI: Settings → Public API. Leave blank to disable native-post
# endpoints; the basic Twitter/FB share-intent buttons keep working either way.
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=

# Optional overrides
# OPENAI_PROMPT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2
# STAGE2_BUDGET_USD=0.10
# LOG_LEVEL=INFO
