# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local secrets
.env
.env.local

# Scratch / local outputs — generated posters are heavy (~2MB each) and
# rebuildable, so keep them out of git history. R2 is the system of record.
outputs/
scratch/

# Local export of the pre-generated background bank (~3MB per image, 277MB+).
# Same reasoning as above: these are model output, regenerable from the bank
# pipeline, and R2 holds the authoritative copy. Committing them would put a
# permanent ~300MB in git history for files that are not source.
bank_export/

# IDEs
.vscode/
.idea/
*.swp

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Binary media assets.
#
# Logos, player photos, game key art and vibe previews are third-party brand
# material (Riot, team orgs, sponsors) and are heavy relative to their value in
# source control. The service reads its real assets from Cloudflare R2, which is
# the system of record; these local copies exist only for demos and fixtures.
# Kept out of the public repo — see README for how to supply your own.
# ---------------------------------------------------------------------------
assets/
Poster-ai-frontend/assets/
backgrounds/*.jpg
backgrounds/*.jpeg
backgrounds/*.png
backgrounds/*.webp
