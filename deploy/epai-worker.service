# EsportsPostAI — RQ worker. This is the half that actually generates.
#
# A stopped worker is a SILENT failure: submissions still return 202 and then
# never progress, because nothing errored. Restart=always is not optional —
# RQ deliberately exits on a Redis connection timeout rather than reconnecting,
# so without it a brief Redis blip stops all generation until someone notices.

[Unit]
Description=EsportsPostAI worker (poster-ai, epai-webhooks)
After=network-online.target
Wants=network-online.target

# INSTALL PATH: every path below assumes /opt/epai. If you install anywhere
# else, change ALL of them together — WorkingDirectory, EnvironmentFile,
# ExecStart and ReadWritePaths. A stale ReadWritePaths is not a visible error:
# ProtectSystem=strict then leaves the service with nowhere to write at all.

[Service]
Type=simple
User=epai
Group=epai
WorkingDirectory=/opt/epai
EnvironmentFile=/opt/epai/.env
ExecStart=/opt/epai/.venv/bin/rq worker poster-ai epai-webhooks --url ${REDIS_URL}

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/epai/scratch

# systemd creates /var/lib/epai, owns it to User= above, and keeps it
# writable under ProtectSystem=strict. Point OUTPUTS_DIR and U2NET_HOME at
# it in the .env for a local poster copy and a persistent rembg model cache.
# Neither is required — the service degrades cleanly without them — but the
# model is re-downloaded on every restart if U2NET_HOME is unset.
StateDirectory=epai

# ── Memory ceiling ───────────────────────────────────────────────────────────
# The worker is the heavier of the two: it loads the imaging stack (onnxruntime,
# numpy, OpenCV) on first use and holds poster bitmaps while compositing.
# Observed peak is well under 1G; the cap exists so a leak or a pathological
# image cannot push the box into an OOM that kills Defendr's MongoDB.
#
# If the worker is being killed repeatedly under normal load, raise this rather
# than removing it — journalctl will show 'memory-max' as the reason.
MemoryMax=1G
MemoryHigh=768M

[Install]
WantedBy=multi-user.target
