# Production .env — the delta from the local one.
#
# Credentials are REUSED (your decision), so copy the local .env up and change
# only the lines below. Everything else — OpenAI, Gemini, R2, RunPod, Postiz,
# ADMIN_TOKEN — carries over untouched.
#
#   scp .env user@vps:/opt/epai/.env
#   ssh user@vps "chmod 600 /opt/epai/.env && chown epai:epai /opt/epai/.env"
#
# Never commit this file. It is gitignored for a reason.

# ── changes ──────────────────────────────────────────────────────────────────

# Our database, our restricted user, on their Mongo. authSource must match the
# database the user was created in, or auth fails with the right password.
MONGODB_URL=mongodb://poster_ai:<password>@localhost:5000/defendr_poster_ai?authSource=defendr_poster_ai
MONGODB_DB=defendr_poster_ai

# Our own Redis instance on 6380, not Defendr's.
REDIS_URL=redis://:<password>@localhost:6380/0

# Defaults to false so localhost dev runs unauthenticated. Left false in
# production, the API is open to anyone who finds the port.
API_KEY_REQUIRED=true

# Defaults to 8000, which is a popular port. Pin it to whatever phase 00 shows
# is free — a service that silently comes up elsewhere looks like an outage.
API_PORT=<free-port-from-survey>

WEBHOOKS_ENABLED=true
WEBHOOK_ALLOW_INSECURE_URLS=false

# Not needed while Defendr proxies server-side, which is the design.
CORS_ALLOW_ORIGINS=

# Set once the API has a public hostname; blank is fine behind the SSH tunnel.
PUBLIC_BASE_URL=

# ── unchanged (reused from local) ────────────────────────────────────────────
# OPENAI_API_KEY · GEMINI_API_KEY · ADMIN_TOKEN · POSTIZ_API_KEY
# R2_ACCESS_KEY_ID · R2_SECRET_ACCESS_KEY · R2_ENDPOINT · R2_BUCKET · R2_PUBLIC_URL
#   ^ same bucket, so the 103 posters already generated stay reachable
# RUNPOD_API_KEY · RUNPOD_ENDPOINT_ID
